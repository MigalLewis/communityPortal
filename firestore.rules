rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && profile().data.status == 'active'; }
    // Privileged capabilities come from Admin SDK custom claims. Profile roles are
    // presentation data and are never an authorization source for these powers.
    function admin() { return active() && request.auth.token.admin == true; }
    function paidResident() { return active() && request.auth.token.paidResident == true; }
    function residentCapability() {
      return active() && (profile().data.role == 'resident' || paidResident());
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['resident', 'paid_resident', 'contractor']
        && request.resource.data.status == (request.resource.data.role == 'resident' ? 'active' : 'pending')
        && request.resource.data.membershipStatus == (request.resource.data.role == 'paid_resident' ? 'pending' : 'none')
        && !request.resource.data.keys().hasAny(['membershipStartedAt', 'membershipExpiresAt', 'externalPaymentReference']);
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow update: if active() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'avatarUrl', 'businessName', 'serviceCategories', 'serviceAreas',
          'businessDescription', 'businessContactEmail', 'businessContactPhone', 'businessWebsite', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /contractors/{contractorId} {
      allow read: if resource.data.status == 'active' && resource.data.hireable == true
        || admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.auth.uid == contractorId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.hireable == false;
      allow update: if active() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'businessName', 'categoryIds', 'serviceAreas', 'bio', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /userTransitionAudits/{auditId} {
      allow read: if admin();
      allow write: if false;
    }

    match /serviceProviders/{id} { allow read: if true; allow write: if admin(); }
    match /categories/{id} { allow read: if true; allow write: if admin(); }
    match /reviews/{id} { allow read: if true; allow write: if residentCapability(); }
    match /jobs/{id} { allow read, write: if residentCapability(); }
    match /messageThreads/{id} { allow read, write: if active(); }
    match /verifications/{id} { allow read, write: if admin(); }
  }
}
