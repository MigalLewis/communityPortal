rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /adverts/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
    match /resources/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|text/csv)')
        && fileName.matches('.*\\.(pdf|doc|docx|xls|xlsx|csv)');
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
